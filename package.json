{
  "name": "voicescribe",
  "version": "1.0.0",
  "private": true,
  "description": "VoiceScribe - Real-Time Multilingual Speech-to-Text Platform with Glassmorphism, Claymorphism & Neumorphism UI",
  "scripts": {
    "dev": "concurrently -n \"NEXT,WS\" -c \"cyan,magenta\" \"next dev\" \"tsx server/ws-server.ts\"",
    "dev:next": "next dev",
    "dev:ws": "tsx server/ws-server.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:ws": "tsx server/ws-server.ts",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
