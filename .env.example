# Database Connection (PostgreSQL - Neon / Supabase / Railway)
DATABASE_URL="postgresql://user:password@your-host/neondb?sslmode=require"

# Google Gemini API Key (Server-side only - Never exposed to browser)
# Free key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# Gemini Model
GEMINI_MODEL="gemini-3.5-flash"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
